# Copy to .env, edit, then `./run_local.sh`. Not committed.
# When deployed to Databricks Apps, app.yaml provides these; .env isn't read.

# ---- Dashboard embed (used by the @databricks/aibi-client SDK) ----
DATABRICKS_HOST=https://fevm-serverless-stable-yrljz5.cloud.databricks.com
WORKSPACE_ID=7474649976481459
DASHBOARD_ID=01f1d713815e18f8ab64879f1b9fce66

# ---- UI ----
APP_NAME=DataCruises Customer Insight

# ---- Auth for /api/dashboard-token (local only) ----
# The backend uses the Databricks SDK's Config() chain against this profile to
# mint a bearer token. Profile must be logged in (`databricks auth login`) or
# configured with a PAT in ~/.databrickscfg.
DATABRICKS_CONFIG_PROFILE=DEFAULT

# ---- Hybrid search (Explore page) ----
# Lakebase Autoscaling (project-based). Credentials are minted per endpoint,
# which the SDK addresses as:
#   projects/<project>/branches/<branch>/endpoints/<endpoint>
LAKEBASE_PROJECT=survey-demo-lakebase
LAKEBASE_BRANCH=production
LAKEBASE_ENDPOINT=primary
LAKEBASE_HOST=ep-calm-moon-d8gqqayh.database.us-east-2.cloud.databricks.com
LAKEBASE_DB=databricks_postgres
LAKEBASE_SCHEMA=survey_demo
LAKEBASE_CONNECT_TIMEOUT=10

# SQL warehouse used to enrich hit survey_ids with UC detail.
DATABRICKS_WAREHOUSE_ID=5f583e258cc6613a
SURVEY_TABLE=serverless_stable_yrljz5_catalog.survey_demo.river_survey_enriched_joined

# Embedding model-serving endpoint. Default is the Databricks-hosted model.
EMBED_ENDPOINT=databricks-gte-large-en

# ---- Local-only ----
# Databricks Apps overrides via DATABRICKS_APP_PORT at runtime.
DATABRICKS_APP_PORT=8000
