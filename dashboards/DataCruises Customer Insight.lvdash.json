{
  "datasets": [
    {
      "name": "ds_survey",
      "displayName": "River Cruise Surveys",
      "queryLines": [
        "SELECT   survey_id,   ship_name,   ship_class,   sailing_date,   DATE_TRUNC('MONTH', sailing_date) AS sailing_month,   overall_experience,   likelihood_to_recommend,   stateroom_satisfaction,   amenities_satisfaction,   CASE WHEN likelihood_to_recommend >= 9 THEN 1 ELSE 0 END AS promoter_flag,   CASE WHEN likelihood_to_recommend <= 6 THEN 1 ELSE 0 END AS detractor_flag FROM river_survey_enriched_joined"
      ],
      "columns": [
        {
          "displayName": "NPS",
          "description": "100 * (promoters - detractors) / total, range -100 to +100.",
          "expression": "100.0 * (SUM(`promoter_flag`) - SUM(`detractor_flag`)) / NULLIF(COUNT(1), 0)"
        },
        {
          "displayName": "Survey Count",
          "description": "Number of completed surveys.",
          "expression": "COUNT(1)"
        },
        {
          "displayName": "Avg Overall Experience",
          "description": "Average 0-10 overall-experience rating.",
          "expression": "AVG(`overall_experience`)"
        },
        {
          "displayName": "Avg Stateroom Satisfaction",
          "description": "Average 0-10 stateroom-satisfaction rating.",
          "expression": "AVG(`stateroom_satisfaction`)"
        },
        {
          "displayName": "Avg Amenities Satisfaction",
          "description": "Average 0-10 amenities-satisfaction rating.",
          "expression": "AVG(`amenities_satisfaction`)"
        }
      ],
      "catalog": "serverless_stable_yrljz5_catalog",
      "schema": "survey_demo"
    },
    {
      "name": "ds_amenity",
      "displayName": "Amenity Mentions",
      "queryLines": [
        "SELECT   amenity_name,   ship_name,   ship_class,   sailing_date,   amenity_sentiment,   CASE WHEN amenity_sentiment = 'positive' THEN 1 ELSE 0 END AS positive_flag,   CASE WHEN amenity_sentiment = 'negative' THEN 1 ELSE 0 END AS negative_flag FROM river_survey_enriched_amenity_exploded WHERE amenity_name IS NOT NULL"
      ],
      "columns": [
        {
          "displayName": "Mentions",
          "description": "Number of amenity mentions.",
          "expression": "COUNT(1)"
        },
        {
          "displayName": "Positive Mentions",
          "expression": "SUM(`positive_flag`)"
        },
        {
          "displayName": "Negative Mentions",
          "expression": "SUM(`negative_flag`)"
        },
        {
          "displayName": "Net Sentiment",
          "description": "(positive - negative) / total. Range -1 to +1.",
          "expression": "(SUM(`positive_flag`) - SUM(`negative_flag`)) * 1.0 / NULLIF(COUNT(1), 0)"
        }
      ],
      "catalog": "serverless_stable_yrljz5_catalog",
      "schema": "survey_demo"
    }
  ],
